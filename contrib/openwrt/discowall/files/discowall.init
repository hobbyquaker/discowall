#!/bin/sh /etc/rc.common
# procd init script for discowalld on OpenWrt (D-10). The settings live in UCI (/etc/config/discowall,
# section `discowall 'main'`); before every start this script renders them to
# /etc/discowall/discowall.toml, which discowalld reads. The rule chain is not in UCI: it lives in
# /etc/discowall/rules.toml, edited with discoctl (or the LuCI app) and written with `discoctl save`.
#
# Interfaces are Linux device names (br-lan, eth1, br-iot), as discoctl and the rules name them.
# A reload (`/etc/init.d/discowall reload`, or LuCI's Save & Apply on the settings) re-renders the
# file; procd restarts the daemon only if the file changed, so a reload that changes nothing keeps
# the live, unsaved rule chain.

START=80
STOP=10
USE_PROCD=1

PROG=/usr/bin/discowalld
CONF=/etc/discowall/discowall.toml

IFACES=""

add_iface() {
	case "$1" in
	""|*[!A-Za-z0-9._@-]*)
		logger -t discowall "ignoring interface name '$1'"
		return 0
		;;
	esac
	IFACES="${IFACES:+$IFACES, }\"$1\""
	NIFACES=$((NIFACES + 1))
}

toml_bool() {
	[ "$1" = 1 ] && echo true || echo false
}

# Writes the TOML for the UCI section `main` to $1; returns 1 if it cannot run (fewer than two
# interfaces).
render() {
	local out="$1" ipv4 ipv6 ssdp rules_file
	IFACES=""
	NIFACES=0
	config_load discowall
	config_list_foreach main interface add_iface
	config_get_bool ipv4 main ipv4 1
	config_get_bool ipv6 main ipv6 1
	config_get_bool ssdp main ssdp 1
	config_get rules_file main rules_file /etc/discowall/rules.toml
	if [ "$NIFACES" -lt 2 ]; then
		logger -t discowall "not started: name at least two interfaces (uci add_list discowall.main.interface=…)"
		return 1
	fi
	rules_file="$(printf '%s' "$rules_file" | sed 's/\\/\\\\/g; s/"/\\"/g')"
	cat > "$out" <<-TOML
		# Generated by /etc/init.d/discowall from /etc/config/discowall: edit that, not this file.
		interfaces = [$IFACES]
		ipv4 = $(toml_bool "$ipv4")
		ipv6 = $(toml_bool "$ipv6")
		ssdp = $(toml_bool "$ssdp")
		rules_file = "$rules_file"
	TOML
}

start_service() {
	local tmp="/var/run/discowall.toml.$$"
	mkdir -p /etc/discowall /var/run/discowall
	render "$tmp" || { rm -f "$tmp"; return 1; }
	# Rewrite the file only when it changes: it lives on flash.
	if cmp -s "$tmp" "$CONF"; then
		rm -f "$tmp"
	else
		mv "$tmp" "$CONF"
	fi

	procd_open_instance
	procd_set_param command "$PROG" --config "$CONF"
	procd_set_param file "$CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	start
}

service_triggers() {
	procd_add_reload_trigger discowall
}

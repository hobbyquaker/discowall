#!/bin/sh /etc/rc.common
# procd init script for discowalld on OpenWrt. The configuration is /etc/discowall/discowall.toml
# (interfaces by their Linux names, e.g. br-lan, br-iot); the control socket lives in /var/run.

START=80
STOP=10
USE_PROCD=1

start_service() {
	mkdir -p /var/run/discowall
	procd_open_instance
	procd_set_param command /usr/bin/discowalld --config /etc/discowall/discowall.toml
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	procd_send_signal discowall '*' HUP
}

service_triggers() {
	procd_add_reload_trigger discowall
}

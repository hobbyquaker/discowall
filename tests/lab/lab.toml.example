# tests/lab/lab.py reads this file; the real one lives outside the repository (D-9), by default at
# ~/.config/discowall-lab/lab.toml, or where --config points. Everything here must match what
# lab-create.sh built (the same ids, tags and addresses).

# The Proxmox node, as `ssh` understands it (an alias from ~/.ssh/config is fine). lab.py runs `pct exec`
# there; the containers need no SSH of their own.
node = "root@pve.example"

# Where the release assets or a local build are copied from: a directory with discowall_<version>_amd64.deb,
# or leave empty and pass --deb.
#deb_dir = "~/Downloads"

[containers]
router = 900
lanhost = 901
iothost = 902
guesthost = 903

# The lab interfaces as the containers see them, with the VLAN tag and the /24 (10.<tag>.0.0/24) and the
# /64 (fd00:<tag>::/64) that lab-create.sh derived from it. The router is .1 on each; the hosts as below.
[networks.lan]
tag = 110
host = "lanhost"
host_addr = "10.110.0.20"
host_addr6 = "fd00:110::20"

[networks.iot]
tag = 120
host = "iothost"
host_addr = "10.120.0.30"
host_addr6 = "fd00:120::30"

[networks.guest]
tag = 130
host = "guesthost"
host_addr = "10.130.0.40"
host_addr6 = "fd00:130::40"

# Optional (case `openwrt`, task 13): an OpenWrt VM with one NIC per lab network, addresses .2 so it
# does not collide with the LXC router; tests/lab/openwrt.md describes how it was built. `ssh` is
# reached through the node (ProxyJump), `http` is fetched with curl on the node (an IPv6 link-local
# address needs the zone, `%25<bridge>` in the URL). `password_file` holds the VM's root password
# (the LuCI login), outside the repository.
#[openwrt]
#vm = 905
#sdk = 904
#ssh = "root@fe80::xxxx:xxxx:xxxx:xxxx%vmbr0"
#http = "http://[fe80::xxxx:xxxx:xxxx:xxxx%25vmbr0]"
#password_file = "~/.config/discowall-lab/openwrt-root-password"
# For `run --ui openwrt` (tests/lab/luci-ui.js): a node_modules directory with playwright-core and a
# Firefox executable (playwright's own build works); screenshots go to ui_screenshots.
#ui_node_path = "~/some-project/node_modules"
#ui_firefox = "~/.cache/ms-playwright/firefox-NNNN/firefox/firefox"
#ui_screenshots = "/tmp/discowall-luci-ui"
#
#[openwrt.interfaces]       # lab network -> the OpenWrt device that carries it
#lan = "br-lan"
#iot = "eth2"
#guest = "eth3"
